<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE8"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPACE / BOOKING"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#26332C"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARED OFFICE SPACE"
            android:textSize="12sp"
            android:textColor="#6B7F6E"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:layout_marginBottom="45dp" />

        <TextView
            android:id="@+id/welcomeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, Employee!"
            android:textAlignment="center"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#26332C"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What would you like to do today?"
            android:textAlignment="center"
            android:textSize="14sp"
            android:textColor="#777D76"
            android:layout_marginBottom="35dp" />

        <Button
            android:id="@+id/findARoomButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Find a Room"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/myBookingsButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="My Bookings"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#26332C"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="25dp" />

        <Button
            android:id="@+id/logOutButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Log Out"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#6B7F6E"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
