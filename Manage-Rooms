<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE8"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SPACE / BOOKING"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#26332C"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHARED OFFICE SPACE"
                android:textSize="10sp"
                android:textColor="#6B7F6E"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Rooms"
                android:textAlignment="center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#26332C"
                android:layout_marginBottom="15dp" />

            <Button
                android:id="@+id/bookForEmployeeButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Book for an Employee"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="15dp" />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D9E1D9"
                android:layout_marginBottom="15dp" />

            <TextView
                android:id="@+id/roomAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Rooms"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#34483C"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/roomASelect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Room A"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="#26332C"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="7dp" />

            <Button
                android:id="@+id/roomBSelect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Room B"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="#26332C"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="7dp" />

            <Button
                android:id="@+id/roomCSelect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Room C"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="#26332C"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/requestBooking"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Submit Booking Request"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
