<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE8"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SPACE / BOOKING"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#26332C"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHARED OFFICE SPACE"
                android:textSize="10sp"
                android:textColor="#6B7F6E"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:layout_marginBottom="13dp" />

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Book a Room"
                android:textAlignment="center"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#26332C"
                android:layout_marginBottom="13dp" />

            <TextView
                android:id="@+id/dateInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#34483C"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/dateSelection"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_background"
                android:padding="10dp"
                android:inputType="date"
                android:textSize="13sp"
                android:hint="Select a date"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/startTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Time"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#34483C"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/startTimeSelection"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_background"
                android:padding="10dp"
                android:inputType="time"
                android:textSize="13sp"
                android:hint="Select start time"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/endTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="End Time"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#34483C"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/endTimeSelection"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_background"
                android:padding="10dp"
                android:inputType="time"
                android:textSize="13sp"
                android:hint="Select end time"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Search Availability"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D9E1D9"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/roomAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Rooms"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#26332C"
                android:layout_marginBottom="7dp" />

            <Button
                android:id="@+id/roomASelect"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Meeting Room A"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#26332C"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="5dp" />

            <Button
                android:id="@+id/roomBSelect"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Meeting Room B"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#26332C"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="5dp" />

            <Button
                android:id="@+id/roomCSelect"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Meeting Room C"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#26332C"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="9dp" />

            <Button
                android:id="@+id/requestBooking"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Submit Booking Request"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
