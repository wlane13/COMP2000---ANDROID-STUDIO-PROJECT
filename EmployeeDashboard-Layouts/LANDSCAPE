<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE8"
    tools:context=".MainActivityKotlin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SPACE / BOOKING"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#26332C"
                android:gravity="center"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHARED OFFICE SPACE"
                android:textSize="11sp"
                android:textColor="#6B7F6E"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/welcomeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome, Employee!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#26332C"
                android:gravity="center"
                android:layout_marginTop="30dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What would you like to do today?"
                android:textSize="13sp"
                android:textColor="#777D76"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="15dp">

            <Button
                android:id="@+id/findARoomButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Find a Room"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/myBookingsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="My Bookings"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#26332C"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/logOutButton"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="Log Out"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#26332C"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 
