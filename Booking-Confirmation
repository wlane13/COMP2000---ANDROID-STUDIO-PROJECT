<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE8"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPACE / BOOKING"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#26332C"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:layout_marginBottom="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARED OFFICE SPACE"
            android:textSize="10sp"
            android:textColor="#6B7F6E"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:layout_marginBottom="35dp" />

        <TextView
            android:id="@+id/bookingConfirmationNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Request Submitted!"
            android:textAlignment="center"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#26332C"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/information"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your booking request will be reviewed by a manager."
            android:textAlignment="center"
            android:textSize="15sp"
            android:textColor="#777D76"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="35dp" />

        <Button
            android:id="@+id/requestAnotherBooking"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Request New Room"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/backToDashboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Back to Dashboard"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#26332C"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
