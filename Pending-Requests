<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPACE / BOOKING"
            android:textColor="#26332C"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHARED OFFICE SPACE"
            android:textColor="#777D76"
            android:textSize="9sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/pendingRequestsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pending Requests"
            android:textColor="#26332C"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#D9E1D9" />

        <TextView
            android:id="@+id/bookingRequestsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="Booking Requests"
            android:textColor="#34483C"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/employeeRequest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Smith"
                android:textColor="#26332C"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Meeting Room A"
                android:textColor="#34483C"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="01/01/2026, 10:00 - 11:00"
                android:textColor="#777D76"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/approveBookingButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Approve"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/button_primary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/rejectBookingButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Reject"
                    android:textColor="#26332C"
                    android:textSize="12sp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#D9E1D9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="Cancellation Requests"
            android:textColor="#34483C"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Smith"
                android:textColor="#26332C"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Meeting Room B"
                android:textColor="#34483C"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="02/01/2026, 13:00 - 15:00"
                android:textColor="#777D76"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/approveCancellationButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Approve"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/button_primary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/rejectCancellationButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Reject"
                    android:textColor="#26332C"
                    android:textSize="12sp"
                    android:background="@drawable/button_secondary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
